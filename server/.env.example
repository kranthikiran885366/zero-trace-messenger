# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/securechat

# Security Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRE=24h
BCRYPT_ROUNDS=12

# Client Configuration
CLIENT_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=50000000
UPLOAD_PATH=./uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/json

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Encryption Configuration
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_LENGTH=32

# Message Configuration
MESSAGE_RETENTION_DAYS=7
MAX_MESSAGE_LENGTH=5000
MAX_ROOM_CAPACITY=50

# Cleanup Configuration
CLEANUP_INTERVAL=3600000
INACTIVE_ROOM_THRESHOLD=86400000

# Socket Configuration
SOCKET_TIMEOUT=60000
MAX_SOCKET_CONNECTIONS=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Redis Configuration (Optional - for scaling)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@securechat.app

# Dark Web Features
ENABLE_ONION_ROUTING=true
ENABLE_CRYPTO_MIXER=true
ENABLE_STEGANOGRAPHY=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API Features
ENABLE_FILE_SHARING=true
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_NOTES=true
ENABLE_STEALTH_MODE=true
