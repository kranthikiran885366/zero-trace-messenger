# Frontend Environment Variables

# Firebase Configuration (Required for authentication)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration
VITE_API_URL=https://api.securechat.app
VITE_WS_URL=wss://api.securechat.app

# Application Configuration
VITE_APP_NAME=SecureChat
VITE_APP_VERSION=2.1.0
VITE_APP_DESCRIPTION=Secure Anonymous Communication Platform

# Feature Flags
VITE_ENABLE_UNDERGROUND_FEATURES=true
VITE_ENABLE_FILE_SHARING=true
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_STEGANOGRAPHY=true
VITE_ENABLE_ONION_ROUTING=true
VITE_ENABLE_CRYPTO_MIXER=true

# Security Configuration
VITE_MAX_FILE_SIZE=100000000
VITE_MAX_MESSAGE_LENGTH=5000
VITE_DEFAULT_MESSAGE_TIMER=300000
VITE_MAX_ROOM_CAPACITY=50

# Development Configuration
VITE_DEBUG_MODE=false
VITE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=false

# External Services (Optional)
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=
VITE_CAPTCHA_SITE_KEY=

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_OFFLINE_SUPPORT=true

# Stealth Mode Configuration
VITE_STEALTH_MODE_ENABLED=true
VITE_STEALTH_MODE_DISGUISES=calculator,notepad,news

# Tor Network Configuration (for Underground features)
VITE_TOR_PROXY_URL=
VITE_ONION_SERVICE_URL=

# Blockchain Configuration (for Crypto Mixer)
VITE_BITCOIN_TESTNET=true
VITE_MONERO_TESTNET=true
VITE_ZCASH_TESTNET=true

# Performance Configuration
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_CACHING=true
VITE_CACHE_DURATION=3600000

# UI Configuration
VITE_DEFAULT_THEME=cyber
VITE_ENABLE_ANIMATIONS=true
VITE_REDUCE_MOTION=false

# Notification Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_NOTIFICATION_ICON=/icon-192.png

# Development URLs (for local development)
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000
