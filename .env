# Development Environment - Real-Time Backend Configuration
# This file is configured for the real-time system implementation

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration - Using Vite dev server with real-time plugin
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_SSE_URL=http://localhost:8080

# Backend Server Configuration  
VITE_BACKEND_PORT=3000
VITE_FRONTEND_PORT=8080

# Application Configuration
VITE_APP_NAME=SecureChat
VITE_APP_VERSION=2.1.0
VITE_APP_DESCRIPTION=Secure Anonymous Communication Platform with Real-Time Features

# Real-Time Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_SSE=true
VITE_ENABLE_WEBSOCKETS=true
VITE_ENABLE_NOTIFICATIONS=true

# Core Feature Flags
VITE_ENABLE_UNDERGROUND_FEATURES=true
VITE_ENABLE_FILE_SHARING=true
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_STEGANOGRAPHY=true
VITE_ENABLE_ONION_ROUTING=true
VITE_ENABLE_CRYPTO_MIXER=true

# Security Configuration
VITE_MAX_FILE_SIZE=100000000
VITE_MAX_MESSAGE_LENGTH=5000
VITE_DEFAULT_MESSAGE_TIMER=300000
VITE_MAX_ROOM_CAPACITY=50
VITE_ENCRYPTION_ENABLED=true

# Real-Time Performance Configuration
VITE_SSE_RETRY_DELAY=1000
VITE_SSE_MAX_RETRIES=5
VITE_HTTP_POLLING_INTERVAL=10000
VITE_RECONNECT_INTERVAL=5000
VITE_CONNECTION_TIMEOUT=30000

# Development Configuration
VITE_DEBUG_MODE=true
VITE_MOCK_DATA=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true

# Room Management Configuration
VITE_ROOM_CLEANUP_INTERVAL=300000
VITE_INACTIVE_ROOM_THRESHOLD=900000
VITE_MAX_ACTIVE_ROOMS=100

# File Management Configuration
VITE_FILE_CLEANUP_INTERVAL=600000
VITE_FILE_EXPIRY_TIME=3600000
VITE_MAX_CONCURRENT_UPLOADS=5

# Notification Configuration
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_SOUND_NOTIFICATIONS=true
VITE_NOTIFICATION_ICON=/icon-192.png
VITE_NOTIFICATION_TIMEOUT=5000

# UI Configuration
VITE_DEFAULT_THEME=cyber
VITE_ENABLE_ANIMATIONS=true
VITE_REDUCE_MOTION=false
VITE_DARK_MODE_DEFAULT=true

# External Services (Optional)
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=
VITE_CAPTCHA_SITE_KEY=

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_OFFLINE_SUPPORT=true
VITE_SERVICE_WORKER_ENABLED=true

# Stealth Mode Configuration
VITE_STEALTH_MODE_ENABLED=true
VITE_STEALTH_MODE_DISGUISES=calculator,notepad,news

# Tor Network Configuration (for Underground features)
VITE_TOR_PROXY_URL=
VITE_ONION_SERVICE_URL=

# Blockchain Configuration (for Crypto Mixer)
VITE_BITCOIN_TESTNET=true
VITE_MONERO_TESTNET=true
VITE_ZCASH_TESTNET=true

# Performance Configuration
VITE_ENABLE_CACHING=true
VITE_CACHE_DURATION=3600000
VITE_REQUEST_DEDUPLICATION=true

# Error Handling Configuration
VITE_ENABLE_ERROR_REPORTING=true
VITE_MAX_ERROR_RETRIES=3
VITE_ERROR_RETRY_DELAY=2000

# Development URLs (commented out - using vite dev server)
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=ws://localhost:3000
